<?xml version="1.0" encoding="utf-8"?>
<!--
    시작 화면(01) 하단의 구름 일러스트다. 피그마 원본처럼 반투명 타원 여러 개를 겹쳐 만든다.
    겹치는 부분은 투명도가 누적되어 조금 더 진하게 보이고, 왼쪽 끝은 그라데이션으로 흐려진다.
    표시 크기는 AuthStartCloudIllustration에서 화면 폭에 맞춰 늘리므로 여기 크기는 비율 기준이다.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="200dp"
    android:height="90dp"
    android:viewportWidth="400"
    android:viewportHeight="180">

    <!-- 왼쪽으로 길게 퍼지며 흐려지는 아래쪽 구름 -->
    <path android:pathData="M30,125a110,48 0,1 0,220 0a110,48 0,1 0,-220 0z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="30"
                android:startY="125"
                android:endX="200"
                android:endY="125">
                <item android:offset="0" android:color="#00C9DBFA" />
                <item android:offset="1" android:color="#66C9DBFA" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- 뒤쪽의 큰 바탕 구름 -->
    <path android:pathData="M110,108a150,72 0,1 0,300 0a150,72 0,1 0,-300 0z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="260"
                android:startY="36"
                android:endX="260"
                android:endY="180">
                <item android:offset="0" android:color="#66DCE7FB" />
                <item android:offset="1" android:color="#40DCE7FB" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- 위로 솟은 봉우리 -->
    <path
        android:fillColor="#4DCFDEFA"
        android:pathData="M210,62a92,58 0,1 0,184 0a92,58 0,1 0,-184 0z" />

    <!-- 가운데 겹침이 가장 진한 덩어리 -->
    <path
        android:fillColor="#4DB9CFF7"
        android:pathData="M168,98a68,56 0,1 0,136 0a68,56 0,1 0,-136 0z" />

    <!-- 오른쪽 둥근 덩어리 -->
    <path
        android:fillColor="#40C3D6F8"
        android:pathData="M300,112a62,50 0,1 0,124 0a62,50 0,1 0,-124 0z" />

    <!-- 아래쪽을 받치는 납작한 타원 -->
    <path
        android:fillColor="#40C9DBFA"
        android:pathData="M150,150a115,32 0,1 0,230 0a115,32 0,1 0,-230 0z" />
</vector>
